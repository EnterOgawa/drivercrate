#pragma code_page(65001)

#include <Windows.h>
#include <CommCtrl.h>

#include "app/resource.h"
#include "drivercrate_version.h"

//------------------------------------------------------------------------------
// Icon resource定義。
//------------------------------------------------------------------------------
IDI_DRIVERCRATE ICON "assets\\drivercrate.ico"

// EULA本文は実行時のplain textだけを表示し、公式の全文をresourceへ同梱しない。
IDD_PREPARATION_EULA DIALOGEX 0, 0, 560, 404
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "使用許諾の確認（今回の取得対象のみ）"
FONT 10, "Segoe UI"
BEGIN
	LTEXT "以下の全文を確認してください。同意はこの対象・改訂版の今回の取得だけに適用します。",
		  -1, 10, 9, 540, 26
	LTEXT "改訂識別子:", -1, 10, 37, 70, 14
	LTEXT "", IDC_PREPARATION_EULA_REVISION, 82, 37, 468, 14
	CONTROL "", IDC_PREPARATION_EULA_TEXT, "Edit",
			WS_BORDER | WS_TABSTOP | WS_VSCROLL | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL,
			10, 56, 540, 255
	LTEXT "本文に既存契約（CNDA等）・組織を代表する権限・用途制限などの条件があります。DriverCrateは条件への適合を判定しません。不明または満たさない場合は同意せず中止してください。",
		  IDC_PREPARATION_PREREQUISITE_NOTE, 10, 317, 540, 30
	CONTROL "本文記載の取得前提を満たすことを確認しました", IDC_PREPARATION_PREREQUISITES,
			"Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 351, 540, 18
	PUSHBUTTON "全文に同意する", IDYES, 340, 376, 100, 20
	DEFPUSHBUTTON "同意しない", IDCANCEL, 450, 376, 100, 20
END

// 毎回未選択の条件確認だけを行う。PayloadやEULAの承認dialogではない。
IDD_METADATA_DETAILS DIALOGEX 0, 0, 520, 340
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "情報検索の結果・条件"
FONT 9, "Segoe UI"
BEGIN
	LTEXT "表示専用の詳細と確認状態(&R)", -1, 10, 8, 500, 14
	EDITTEXT IDC_METADATA_DETAIL_TEXT, 10, 24, 500, 278,
		ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
	DEFPUSHBUTTON "閉じる(&C)", IDOK, 430, 314, 80, 18
END

IDD_METADATA_SEARCH DIALOGEX 0, 0, 520, 340
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "情報検索 — 今回の対象と通信条件"
FONT 9, "Segoe UI"
BEGIN
	LTEXT "公式ページの配布情報だけを検索します。ドライバー本体は取得せず、検査用取得・インストール・EULA同意も行いません。現在のデバイス属性は端末内だけで照合します。", -1, 10, 8, 500, 32
	LTEXT "検索対象(&P): 対応Providerだけ選択できます。毎回、未選択から開始します。", -1, 10, 43, 500, 14
	CONTROL "", IDC_METADATA_PROVIDER_LIST, "SysListView32",
		WS_BORDER | WS_TABSTOP | WS_VSCROLL | LVS_REPORT | LVS_SHOWSELALWAYS, 10, 59, 500, 130
	LTEXT "本文上限: 1応答 2 MiB ／ Provider合計 4 MiB ／ 全体 32 MiB。失敗分とcache本文も計数します。Logical resource上限 2／18、明示送信上限 12／108（Provider／全体）。期限 90秒／300秒。同期API中は直ちに取り消せない場合があります。", -1, 10, 195, 500, 42
	LTEXT "制限・未知回線では、以下に明示同意しない限り新しい通信を開始しません。通常catalog cacheを有限に読み書きします。これらの上限は回線課金総量の保証ではありません。", -1, 10, 239, 500, 32
	CONTROL "制限・未知回線のmetadata通信を今回だけ許可する(&N)", IDC_METADATA_NETWORK_APPROVAL,
		"Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 275, 500, 17
	LTEXT "", IDC_METADATA_SELECTION_STATUS, 10, 296, 500, 15
	PUSHBUTTON "情報検索を開始(&M)", IDYES, 302, 315, 106, 18
	DEFPUSHBUTTON "キャンセル", IDCANCEL, 416, 315, 94, 18
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DRIVERCRATE_VERSION_COMMA
 PRODUCTVERSION DRIVERCRATE_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
/* Debug build の version resource にだけ debug 属性を付与する。 */
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "041104B0"
		BEGIN
			VALUE "CompanyName", "EnterSystem"
			VALUE "FileDescription", "DriverCrate - Windows driver update manager"
			VALUE "FileVersion", DRIVERCRATE_VERSION_STRING
			VALUE "InternalName", "DriverCrate"
			VALUE "LegalCopyright", "Copyright (C) 2026 Shunji Ogawa"
			VALUE "OriginalFilename", "DriverCrate.exe"
			VALUE "ProductName", "DriverCrate"
			VALUE "ProductVersion", DRIVERCRATE_VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0411, 1200
	END
END

