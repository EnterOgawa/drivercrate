#pragma once
#include <array>
#include <cstdint>
#include <string_view>

namespace drivercrate {
/** @brief 一つのraw resourceを固定ID・path・size・SHA-256へ結合します。 */
struct CollectorEmbeddedResource {
	/// compile時の固定相対名。
	std::wstring_view path ;
	/// 4000から始まる固定整数ID。
	std::uint16_t resourceId ;
	/// 実resourceに要求するbyte数。
	std::uint64_t bytes ;
	/// 小文字64桁の原SHA-256。
	std::wstring_view sha256 ;
} ;
// builderが既存package validatorで受理した全fileだけを固定順に生成する。
inline constexpr std::array<CollectorEmbeddedResource, @COLLECTOR_RESOURCE_COUNT@> EMBEDDED_RESOURCES{{
@COLLECTOR_RESOURCE_ROWS@
}} ;
} // namespace drivercrate
