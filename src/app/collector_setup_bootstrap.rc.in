#include <Windows.h>
#pragma code_page(65001)
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 VERSIONINFO
 FILEVERSION @COLLECTOR_VERSION_COMMAS@,0
 PRODUCTVERSION @COLLECTOR_VERSION_COMMAS@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "EnterSystem\0"
   VALUE "FileDescription", "DriverCrate Collector Setup (unsigned preview)\0"
   VALUE "FileVersion", "@COLLECTOR_VERSION@\0"
   VALUE "ProductName", "DriverCrate\0"
   VALUE "ProductVersion", "@COLLECTOR_VERSION@\0"
   VALUE "OriginalFilename", "DriverCrateCollectorSetup-@COLLECTOR_VERSION@-windows-x64.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
@COLLECTOR_RESOURCE_RC@
