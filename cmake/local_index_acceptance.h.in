#pragma once
#include "platform/signed_index_manifest_internal.h"
#include <array>
#include <cstdint>
#include <string_view>

namespace drivercrate::local_index_profile {

// Local受入と製品配布の信頼集合を和集合にしないための固定選択です。
inline constexpr bool ENABLED = @drivercrate_local_index_enabled@;
// 一度読んだ不変byteから完全fingerprintとshapeを確認したpublic byteだけです。
inline constexpr std::array<std::uint8_t, @drivercrate_local_index_key_count@ * 411U> PUBLIC_BLOB{
	@drivercrate_local_index_blob_values@
};
// 公開blobの完全SHA-256。通常profileでは空です。
inline constexpr std::string_view PUBLIC_FINGERPRINT = "@drivercrate_local_index_fingerprint@";
// Public fingerprintへ結合したlocal専用ID。通常profileでは空です。
inline constexpr std::string_view KEY_ID = "@drivercrate_local_index_key_id@";
// Manifest信頼だけの固定集合。取得能力を自動生成しません。
inline constexpr std::array<signed_index_detail::TrustKey, @drivercrate_local_index_key_count@U> TRUST_KEYS{{
	@drivercrate_local_index_trust_entry@
}};
// 独立optionでだけ登録したrevision1取得能力の固定集合です。
inline constexpr std::array<std::string_view, @drivercrate_local_index_acquisition_count@U> ACQUISITION_KEYS{
	@drivercrate_local_index_acquisition_entry@
};

} // namespace drivercrate::local_index_profile
