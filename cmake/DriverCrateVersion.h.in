#pragma once

// Windows VERSIONINFOへ渡すcomma区切りの四要素数値版。
#define DRIVERCRATE_VERSION_COMMA                                                           \
	@PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
// Product versionをUTF-8文字列として表す値。
#define DRIVERCRATE_VERSION_STRING "@PROJECT_VERSION@"
// C++の公開計測snapshotへ保持するwide文字列版。
#define DRIVERCRATE_VERSION_WSTRING L"@PROJECT_VERSION@"
// Top-level Window titleへ表示するapplication名とversion。
#define DRIVERCRATE_WINDOW_TITLE_STRING "DriverCrate @PROJECT_VERSION@"
