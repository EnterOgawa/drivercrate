# ADR0348: source正本から非秘密のprofileを読み、完成EXEの原hashへ結合する。
# Include時は関数定義だけ。-P実行時も鍵storeやEXEを起動しない。
function(drivercrate_distribution_profile fingerprint_output revision_output)
    set(trust_header "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/platform/index_distribution_trust.h")
    file(SIZE "${trust_header}" trust_size)
    if(trust_size GREATER 16384)
        message(FATAL_ERROR "Distribution trust header exceeds its finite profile limit.")
    endif()
    file(READ "${trust_header}" trust_source LIMIT 16385)
    string(REGEX MATCHALL "PUBLIC_FINGERPRINT[ \t\r\n]*=[ \t\r\n]*\"([0-9a-f]+)\"" fingerprints "${trust_source}")
    string(REGEX MATCHALL "ACQUISITION_POLICY_REVISION[ \t\r\n]*=[ \t\r\n]*([0-9]+)U" revisions "${trust_source}")
    list(LENGTH fingerprints fingerprint_count)
    list(LENGTH revisions revision_count)
    if(NOT fingerprint_count EQUAL 1 OR NOT revision_count EQUAL 1)
        message(FATAL_ERROR "Distribution profile declarations are ambiguous.")
    endif()
    string(REGEX REPLACE ".*\"([0-9a-f]+)\"" "\\1" fingerprint "${fingerprints}")
    string(LENGTH "${fingerprint}" fingerprint_length)
    string(REGEX REPLACE ".*=[ \t\r\n]*([0-9]+)U" "\\1" revision "${revisions}")
    if(NOT fingerprint_length EQUAL 64 OR NOT revision STREQUAL "1")
        message(FATAL_ERROR "Distribution public pin/revision is invalid.")
    endif()
    set(${fingerprint_output} "${fingerprint}" PARENT_SCOPE)
    set(${revision_output} "${revision}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT DEFINED EXECUTABLE OR NOT EXISTS "${EXECUTABLE}"
        OR NOT LOCAL_PROFILE MATCHES "^(ON|OFF)$")
        message(FATAL_ERROR "Missing executable or exact ON/OFF index build profile.")
    endif()
    drivercrate_distribution_profile(expected_fingerprint expected_revision)
    if(LOCAL_PROFILE STREQUAL "ON")
        set(local_json true)
        set(expected_fingerprint "")
        set(expected_revision 0)
    else()
        set(local_json false)
    endif()
    if(NOT DEFINED DISTRIBUTION_FINGERPRINT OR NOT DEFINED ACQUISITION_POLICY_REVISION
        OR NOT DISTRIBUTION_FINGERPRINT STREQUAL expected_fingerprint
        OR NOT ACQUISITION_POLICY_REVISION STREQUAL expected_revision)
        message(FATAL_ERROR "Post-link index profile differs from the source policy.")
    endif()
    file(SHA256 "${EXECUTABLE}" executable_hash)
    file(WRITE "${EXECUTABLE}.index-profile.json"
        "{\"schema\":\"drivercrate-index-build-profile-v2\",\"localAcceptance\":${local_json},\"sha256\":\"${executable_hash}\",\"distributionFingerprint\":\"${expected_fingerprint}\",\"acquisitionPolicyRevision\":${expected_revision}}\n")
endif()
